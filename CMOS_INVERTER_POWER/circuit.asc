TEXT 432 -80 Left 2 !* CMOS Inverter - Power Dissipation Analysis\n \n.param VDD_VALUE=5\n.param LCH=1u\n.param WN=10u\n.param WP=20u\n.param CLOAD_VALUE=50f\n \nVDD_SOURCE VDD 0 {VDD_VALUE}\nVIN_SOURCE VIN 0 PULSE(0 {VDD_VALUE} 0 1n 1n 30n 60n)\n \nM_PMOS VOUT VIN VDD VDD PMOS_BASIC L={LCH} W={WP}\nM_NMOS VOUT VIN 0   0   NMOS_BASIC L={LCH} W={WN}\n \nCLOAD VOUT 0 {CLOAD_VALUE}\n \nBPOWER PWR 0 V=V(VDD)*(-I(VDD_SOURCE))\n \n.model NMOS_BASIC NMOS LEVEL=1 VTO=0.7 KP=120u LAMBDA=0.02 GAMMA=0.4 PHI=0.6 CGSO=2e-10 CGDO=2e-10 CBD=1e-12 CBS=1e-12\n \n.model PMOS_BASIC PMOS LEVEL=1 VTO=-0.7 KP=60u LAMBDA=0.02 GAMMA=0.4 PHI=0.6 CGSO=2e-10 CGDO=2e-10 CBD=1e-12 CBS=1e-12\n \n.tran 0 120n 0 0.05n\n \n.meas tran avg_current AVG (-I(VDD_SOURCE)) FROM=60n TO=120n\n.meas tran avg_power AVG V(PWR) FROM=60n TO=120n\n.meas tran max_power MAX V(PWR) FROM=60n TO=120n\n.meas tran energy_cycle INTEG V(PWR) FROM=60n TO=120n\n.meas tran avg_power_calc PARAM='energy_cycle/60n'\n \n.end
