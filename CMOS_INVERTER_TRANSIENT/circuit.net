* Generated by LTspice 24.1.8 for Windows.
M1 N003 N002 N001 N001 PMOS_BASIC
M2 N003 N002 0 0 NMOS_BASIC
VDD N001 0 5
VIN N002 0 PULSE(0 5 0 1n 1n 30n 60n)
C1 N003 0 50F
.model NMOS NMOS
.model PMOS PMOS
.lib C:\Users\adtiw\AppData\Local\LTspice\lib\cmp\standard.mos
.tran 0 80n 0 0.05n
* CMOS Inverter - Transient Analysis
.param VDD=5
.param LCH=1u
.param WN=10u
.param WP=20u
VDD_SOURCE VDD 0 {VDD}
VIN_SOURCE VIN 0 PULSE(0 {VDD} 0 1n 1n 10n 20n)
M_PMOS VOUT VIN VDD VDD PMOS_BASIC L={LCH} W={WP}
M_NMOS VOUT VIN 0   0   NMOS_BASIC L={LCH} W={WN}
CLOAD VOUT 0 20f
.model NMOS_BASIC NMOS LEVEL=1 VTO=0.7 KP=120u LAMBDA=0.02 GAMMA=0.4 PHI=0.6 CGSO=2e-10 CGDO=2e-10 CBD=1e-12 CBS=1e-12
.model PMOS_BASIC PMOS LEVEL=1 VTO=-0.7 KP=60u LAMBDA=0.02 GAMMA=0.4 PHI=0.6 CGSO=2e-10 CGDO=2e-10 CBD=1e-12 CBS=1e-12
;.tran 0.05n 100n 0 0.05n
.meas tran tr TRIG V(VOUT) VAL=0.5 RISE=1 TARG V(VOUT) VAL=4.5 RISE=1
.meas tran tf TRIG V(VOUT) VAL=4.5 FALL=1 TARG V(VOUT) VAL=0.5 FALL=1
.meas tran tphl TRIG V(VIN) VAL=2.5 RISE=1 TARG V(VOUT) VAL=2.5 FALL=1
.meas tran tplh TRIG V(VIN) VAL=2.5 FALL=1 TARG V(VOUT) VAL=2.5 RISE=1
.meas tran tpd PARAM='(tphl+tplh)/2'
.end
.backanno
.end
