* C:\Users\adtiw\OneDrive\Desktop\VLSI_LAB\CMOS_INVERTER_POWER\circuit.asc
* Generated by LTspice 24.1.8 for Windows.
M1 N003 N002 N001 N001 PMOS
M2 N003 N002 0 0 NMOS
VDD N001 0 5
VIN N002 0 PULSE(0 5 0 1n 1n 30n 60n)
C1 N003 0 50f
.model NMOS NMOS
.model PMOS PMOS
.lib C:\Users\adtiw\AppData\Local\LTspice\lib\cmp\standard.mos
* CMOS Inverter - Power Dissipation Analysis
.param VDD_VALUE=5
.param LCH=1u
.param WN=10u
.param WP=20u
.param CLOAD_VALUE=50f
VDD_SOURCE VDD 0 {VDD_VALUE}
VIN_SOURCE VIN 0 PULSE(0 {VDD_VALUE} 0 1n 1n 30n 60n)
M_PMOS VOUT VIN VDD VDD PMOS_BASIC L={LCH} W={WP}
M_NMOS VOUT VIN 0   0   NMOS_BASIC L={LCH} W={WN}
CLOAD VOUT 0 {CLOAD_VALUE}
BPOWER PWR 0 V=V(VDD)*(-I(VDD_SOURCE))
.model NMOS_BASIC NMOS LEVEL=1 VTO=0.7 KP=120u LAMBDA=0.02 GAMMA=0.4 PHI=0.6 CGSO=2e-10 CGDO=2e-10 CBD=1e-12 CBS=1e-12
.model PMOS_BASIC PMOS LEVEL=1 VTO=-0.7 KP=60u LAMBDA=0.02 GAMMA=0.4 PHI=0.6 CGSO=2e-10 CGDO=2e-10 CBD=1e-12 CBS=1e-12
.tran 0 120n 0 0.05n
.meas tran avg_current AVG (-I(VDD_SOURCE)) FROM=60n TO=120n
.meas tran avg_power AVG V(PWR) FROM=60n TO=120n
.meas tran max_power MAX V(PWR) FROM=60n TO=120n
.meas tran energy_cycle INTEG V(PWR) FROM=60n TO=120n
.meas tran avg_power_calc PARAM='energy_cycle/60n'
.end
.backanno
.end
